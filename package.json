{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm -r --if-present run build",
    "typecheck:libs": "echo 'Skipping typecheck'"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1",
      "postcss": "^8.5.10",
      "esbuild": "^0.28.1"
    }
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
