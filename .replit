modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-admin"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api"

[[workflows.workflow]]
name = "typecheck-mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc -p artifacts/mobile-app/tsconfig.json --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-admin"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc -p artifacts/admin-dashboard/tsconfig.json --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc -p artifacts/api-server/tsconfig.json --noEmit"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_BOOTSTRAP_TOKEN = "63b26f7a781f8f66f8e6450d2350bfcecdefd626d69331c6"
