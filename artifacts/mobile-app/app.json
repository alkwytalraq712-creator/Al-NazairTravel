{
  "expo": {
    "name": "قمة النظائر للسفريات",
    "slug": "mobile-app",
    "owner": "qema-build",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "mobile-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1526"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qema.alnathair"
    },
    "android": {
      "package": "com.qema.alnathair",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#C9A060",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق معرض الصور لرفع صورة شخصية وصورة جواز السفر.",
          "cameraPermission": "يستخدم التطبيق الكاميرا لالتقاط صورة شخصية وصورة جواز السفر."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e9ccf80b-c15b-42b7-8fae-7e3b8f1eb31c"
      }
    }
  }
}
